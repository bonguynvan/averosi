# Copy to .env next to docker-compose.prod.yml on the VPS. Never commit real values.
SITE_HOST=averosi.com
POSTGRES_PASSWORD=change-me-long-random
# Optional image overrides (default: ghcr.io/bonguynvan/averosi-app:latest / -ingestor:latest)
# APP_IMAGE=
# INGESTOR_IMAGE=

# Read by web + worker (env_file). See .env.example for the full list.
DATA_MODE=live
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_BSC=
ARCHIVE_RPC_URL_ETHEREUM=
ARCHIVE_RPC_URL_BASE=
ARCHIVE_RPC_URL_BSC=
