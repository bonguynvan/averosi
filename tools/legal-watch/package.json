{
  "name": "@app/legal-watch",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Weekly scan for new/changed Vietnamese crypto law; opens a GitHub issue for human review. Never edits legal content.",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3"
  }
}
