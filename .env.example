# Copy to .env.local (never commit real values). All optional — defaults live in apps/web/src/lib/brand.ts.
# The brand is a working name: change these (or the defaults) to rebrand without touching components or content.
NEXT_PUBLIC_BRAND_NAME=Averosi
NEXT_PUBLIC_SITE_URL=https://averosi.com
NEXT_PUBLIC_SOURCE_REPO_URL=https://github.com/bonguynvan/averosi
# Defaults to privacy@<site host> when NEXT_PUBLIC_SITE_URL is changed.
NEXT_PUBLIC_CONTACT_EMAIL=privacy@averosi.com

# Risk center (server-only). RPC endpoints default to PublicNode; set your own for higher limits.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_BSC=
# "fixture" = deterministic offline data for e2e tests only. Never set in production.
RISK_DATA_MODE=live
